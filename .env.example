# Copy to .env (never commit .env). Read by backend/main.py.
# LLM provider (default: OpenAI). Override LLM_BASE_URL / LLM_*_MODEL to switch.
LLM_API_KEY=
# 1 = every endpoint returns data/demo_cache.json
DEMO_MODE=0
# Optional cache backend. If unreachable, search falls back to an in-process LRU.
REDIS_URL=redis://localhost:6379/0
